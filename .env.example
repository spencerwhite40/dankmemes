# ── Required ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host/db          # Postgres (Neon works). Tests/local runs use DATABASE_URL_TEST if set.
# AI providers: set the ones you have. Video is watched by Google Gemini; captions are written by Claude, Gemini and GPT
# (best available first), so set at least GOOGLE_API_KEY. Keys are typed into the host's settings, never committed or pasted in chat.
GOOGLE_API_KEY=                                    # Gemini: watches video and writes captions
ANTHROPIC_API_KEY=                                 # Claude: caption writing (humor)
OPENAI_API_KEY=                                    # GPT: caption writing fallback
KIE_API_KEY=                                       # kie.ai: optional, only while its credits last
# Model names can be changed (check them with: npm run models:check):
#   GOOGLE_FLASH_MODEL, GOOGLE_PRO_MODEL, ANTHROPIC_WRITER_MODEL, ANTHROPIC_BALANCED_MODEL, OPENAI_MODEL
#   or whole chains: MEME_BUILDER_VIDEO_MODELS / MEME_BUILDER_TEXT_MODELS (comma lists of provider:model, e.g. google:gemini-3.1-pro)
# Optional prices per million tokens, so usage shows a cost: MODEL_PRICES_JSON={"google:gemini-3.1-pro":{"input":0,"output":0,"cached_input":0}}
SESSION_SECRET=                                    # any long random string; signs the expiring video playback links
ADMIN_EMAILS=                                      # comma list: these accounts are admins when they sign up or in
# SIGNUPS=closed                                   # stop new sign-ups

# ── Storage for uploaded videos and finished clips (Cloudflare R2). If unset, files go to the local disk,
#    which is wiped on every restart/deploy, so set these for anything real. ──────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Optional ───────────────────────────────────────────────────────────────
MEME_BUILDER_RUNNER=on          # "off" on the web app when the runner runs on its own machine (npm run worker)
MEME_BUILDER_MAX_UPLOAD_MB=500
PORT=3000
