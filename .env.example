# ── Required ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host/db          # Postgres (Neon works). Tests/local runs use DATABASE_URL_TEST if set.
KIE_API_KEY=                                       # AI models for now (kie.ai). Direct provider keys come next.
APP_PASSWORD=                                      # the one shared password. If empty, there is NO login (dev only).
SESSION_SECRET=                                    # any long random string; signs the login cookie

# ── Storage for uploaded videos and finished clips (Cloudflare R2). If unset, files go to the local disk,
#    which is wiped on every restart/deploy, so set these for anything real. ──────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Optional ───────────────────────────────────────────────────────────────
MEME_BUILDER_RUNNER=on          # "off" on the web app when the runner runs on its own machine (npm run worker)
MEME_BUILDER_MAX_UPLOAD_MB=500
ANTHROPIC_API_KEY=              # direct Claude fallback for captions (unused until funded)
PORT=3000
