# ── Required ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host/db          # Postgres (Neon works). Tests/local runs use DATABASE_URL_TEST if set.
# AI providers: set the ones you have. Video is watched by Google Gemini; captions are written by Claude, Gemini and GPT
# (best available first), so set at least GOOGLE_API_KEY. Keys are typed into the host's settings, never committed or pasted in chat.
GOOGLE_API_KEY=                                    # Gemini: watches video and writes captions
ANTHROPIC_API_KEY=                                 # Claude: caption writing (humor)
OPENAI_API_KEY=                                    # GPT: caption writing fallback
# KIE_API_KEY=                                    # kie.ai: optional gateway, only if you still have credits there
# Model names can be changed (check them with: npm run models:check):
#   GOOGLE_FLASH_MODEL, GOOGLE_PRO_MODEL, ANTHROPIC_WRITER_MODEL, ANTHROPIC_BALANCED_MODEL, OPENAI_MODEL
#   or whole chains: MEME_BUILDER_VIDEO_MODELS / MEME_BUILDER_TEXT_MODELS (comma lists of provider:model, e.g. google:gemini-3.1-pro)
# Optional prices per million tokens, so usage shows a cost: MODEL_PRICES_JSON={"google:gemini-3.1-pro":{"input":0,"output":0,"cached_input":0}}
SESSION_SECRET=                                    # any long random string; signs the expiring video playback links
ADMIN_EMAILS=                                      # comma list: these accounts are admins when they sign up or in
# ── Email (verification and password reset): off until one of these is set ───────────────────────────────
# RESEND_API_KEY=                                  # or POSTMARK_SERVER_TOKEN=
# EMAIL_FROM="dankmemes <hello@your-domain.com>"   # an address on a domain verified with the provider
# APP_NAME=dankmemes
# ── Legal pages (/terms /privacy /refunds /copyright): fill in, have a lawyer review, then set LEGAL_REVIEWED=yes ──
# COMPANY_NAME=  COMPANY_ADDRESS=  SUPPORT_EMAIL=  COPYRIGHT_EMAIL=  LEGAL_JURISDICTION=  LEGAL_REVIEWED=
# ── Alerts: a Slack or Discord incoming-webhook URL. Without it nothing is sent. One message per kind of problem per 10 minutes. ──
# ALERT_WEBHOOK_URL=
# SIGNUPS=closed                                   # stop new sign-ups
# WATERMARK_TEXT=made with dankmemes                # the words in the watermark on Free and Starter clips

# ── Billing (Stripe): off until STRIPE_SECRET_KEY is set. Setup steps: docs/billing.md ──────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# APP_URL=https://your-app.example.com             # where customers return to after paying
# Price ids from the Stripe dashboard (one per plan and period, and one per top-up pack):
# STRIPE_PRICE_STARTER_MONTHLY= STRIPE_PRICE_STARTER_ANNUAL= STRIPE_PRICE_CREATOR_MONTHLY= STRIPE_PRICE_CREATOR_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY= STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_AGENCY_MONTHLY= STRIPE_PRICE_AGENCY_ANNUAL=
# STRIPE_PRICE_PACK_MINI= STRIPE_PRICE_PACK_SMALL= STRIPE_PRICE_PACK_MEDIUM= STRIPE_PRICE_PACK_LARGE= STRIPE_PRICE_PACK_BULK=

# ── Storage for uploaded videos and finished clips (Cloudflare R2). If unset, files go to the local disk,
#    which is wiped on every restart/deploy, so set these for anything real. ──────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Optional ───────────────────────────────────────────────────────────────
MEME_BUILDER_RUNNER=on          # "off" on the web app when the runner runs on its own machine (npm run worker)
# Web app: start a Fly processing machine per waiting run (src/lib/scaler.js). Off unless both are set.
# FLY_API_TOKEN=                # fly tokens create deploy -a dankmemes-worker
# FLY_WORKER_APP=dankmemes-worker
# WORKER_MAX_MACHINES=3         # the most machines running at once, the cost cap; match `fly scale count worker=N`
# PRIORITY_AGING_SECONDS=120    # when every machine is busy paid runs go first; a free run waiting this long goes in line too
# Processing machine (set in fly.toml):
# WORKER_IDLE_POLL_SECONDS=2    # how often an awake machine looks for the next run
# WORKER_IDLE_EXIT_SECONDS=120  # stop the machine after this long with nothing to do (needs FLY_API_TOKEN on the web app)
# RENDER_CONCURRENCY=3          # clips rendered at once
MEME_BUILDER_MAX_UPLOAD_MB=500
PORT=3000
